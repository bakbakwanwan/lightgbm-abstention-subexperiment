# git-policy.md 5절 기준

# 데이터 (raw/interim/processed 전체)
/data/

# 파이썬 환경/캐시
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Windows 동기화용 임시 경로
_sync/

# 모델 바이너리 / 대용량 파일
*.pt
*.pth
*.ckpt
*.bin
*.onnx

# 재생성 가능한 D-004 행별 분할 배정 데이터
/results/d004_splits/*/*.csv.gz

# EXP 실행 산출물: 핵심 metrics.json과 설명 문서는 추적하고 나머지는 불변 로컬 결과로 보관
/results/EXP-*/predictions/
/results/EXP-*/aurc_curve/
/results/EXP-*/*.csv
/results/EXP-*/candidate_history.json
/results/EXP-*/manifest.json
/results/EXP-*/validation_checks.json

# OS 잡파일
Thumbs.db
.DS_Store

# 로컬 에디터 설정 (Obsidian vault)
.obsidian/
